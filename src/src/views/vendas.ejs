<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="css/vendas.css">
    <title>Vendas</title>
</head>
<body>

    <div class="modal" id="modalVisualizar">
        <div class="modalConteudo">
            <p class='tituloModalVisualizar'>CLIENTE</p>
            <div class="fotoModalVisualizar"></div>
            <p class="nomePerfilModalVisualizar">GABRIEL FERREIRA DE CASTRO</p>

            <p class="tituloProdutosModalVisualizar">PRODUTOS</p>
            
            <p class="dataProdutoModalVisualizar">DATA: 15/10/2024 às 15:30</p>
            <p class="totalVendaModalVisualizar">TOTAL: R$ 40,00</p>
        </div>
    </div>

    <div class="modal" id="modalEditar">
        <div id="modalConteudoEditar" class="modalConteudo modalConteudoEditar">
            <p class="tituloExcluirProdutos">EXCLUIR PRODUTOS DA VENDA</p>
            
        </div>
    </div>



    <header>
        <img src="img/Logo.png" alt="">
        <a href="paginaPrincipalLoja" class="sair">
            <p class="voltar">VOLTAR AO MENU</p>
            <img src="img/Logout.png" alt="">
        </a>
    </header>

    <div class="fotoLoja"></div>
    <p class="tituloLoja"><%= loja.nome %></p>
    <div class="total">
        <p class="tituloTotal">TOTAL EM VENDAS</p>
        <div class="totalVendas">R$ <%= totalVendas %></div>
    </div>
    

    <div class="vendas">
        <div class="tituloVendas">MINHAS VENDAS</div>
        <div class="minhasVendas">
            <% vendas.forEach(item => { %>
                <div class="venda">
                    <div class="visualizar">
                        <img 
                            class="iconeVisualizar" 
                            src="img/Eye.png" 
                            alt="" 
                            data-id="<%= item.id %>" 
                            data-idcliente="<%= item.cliente.dataValues.nome %>"
                            data-produtos='<%= JSON.stringify(item.produtos) %>'
                            data-createdat="<%= item.createdAt %>"
                        >
                        <p class="tituloVenda"> 
                            <%= `${item.cliente.dataValues.nome} - ${new Date(item.createdAt).toLocaleDateString('pt-BR', { day: '2-digit', month: '2-digit' })} - ${new Date(item.createdAt).toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' })}` %> 
                        </p>
                    </div>
                    <div class="editarExcluir">
                        <img class="icone iconeEditar" data-id="<%= item.id %>"  data-produtos='<%= JSON.stringify(item.produtos) %>' src="img/Edit.png" alt="">
                        <img class="icone" src="img/Trash.png" alt="">
                    </div>
                </div>
                <% }) %>
        </div>
    </div>

    <footer></footer>

    <script src="js/vendas.js"></script>
    
</body>
</html>