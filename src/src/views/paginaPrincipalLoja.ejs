<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="css/paginaPrincipalLoja.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lalezar&display=swap" rel="stylesheet">
    <title>Página Inicial</title>
</head>
<body>

    <header>
        <div class="sair">
            <img src="img/sair.png" alt="">
            <p class="sairTexto">SAIR</p>
        </div>
        <img src="img/logo.png" alt="">
        <div class="minhaEmpresa">
            <p class="textoEmpresa">MINHA LOJA</p>
            <div class="imagemEmpresa"></div>
        </div>
    </header>

    <p class="nomeDaLojaTitulo">ACERBINHO LANCHES</p>

    <div class="opcoes">
        <a href="/produto" class="quadrado quadradoCardapio">
            <img class="imgCardapio" src="img/cardapio.png" alt="">
            <div class="escrito">CARDAPIO</div>
        </a>
        <div class="quadrado quadradoVendas">
            <img class="imgCrescimento" src="img/crescimento.png" alt="">
            <div class="escrito">VENDAS</div>
        </div>
    </div>
    
    <div class="tituloProdutosMais">
        <img src="img/trofeu.png" alt="">
        <p class="tituloProdutosTitulo">PRODUTOS MAIS VENDIDOS</p>
        <img src="img/trofeu.png" alt="">
    </div>

    <div class="produtosMais">
        <div class="produto">
            <div class="imagemProduto"></div>
            <p class="nomeProduto">Pastel de Carne</p>
            <p class="nomeProduto">250 unidades</p>
        </div>
    </div>

    <footer></footer>
</body>
</html>