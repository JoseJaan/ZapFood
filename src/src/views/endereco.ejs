<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="css/endereco.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lalezar&display=swap" rel="stylesheet">
    <title>Meu Perfil</title>
</head>
<body>

    <div class="modal" id="modalAdicionar">
        <div class="modalConteudo">
            <p class="tituloModalAdicionar">ADICIONAR ENDEREÇO</p>
            <div class="camposModalAdicionar">
            <div class="campo campoNome">
                <label for="nome">NOME</label>
                <input type="text" name="" id="nome">
            </div>


            <div class="campo campoCidade">
                <label for="cidade">CIDADE</label>
                <input type="text" name="" id="cidade">
            </div>

            <div class="campo campoCEP">
                <label for="cep">CEP</label>
                <input type="text" name="" id="cep">
            </div>

            <div class="campo campoRua">
                <label for="rua">RUA</label>
                <input type="text" name="" id="rua">
            </div>

            <div class="campo campoN">
                <label for="numero">Nº</label>
                <input type="number" name="" id="numero">
            </div>

            <div class="campo">
                <label for="complementoAdicionar">COMPLEMENTO</label>
                <input type="text" name="" id="complementoAdicionar">
            </div>
        </div>
            <button class="botaoAdicionarModal">ADICIONAR</button>
        </div>
        
    </div>


    <div class="modal" id="modalEditar">
        <div class="modalConteudo">
            <p class="tituloModalAdicionar">EDITAR ENDEREÇO</p>
            <div class="camposModalAdicionar">
            <div class="campo campoNome">
                <label for="nome">NOME</label>
                <input type="text" name="" id="nomeAtualizar">
            </div>

            <div class="campo campoCidade">
                <label for="cidade">CIDADE</label>
                <input type="text" name="" id="cidadeAtualizar">
            </div>

            <div class="campo campoCEP">
                <label for="cep">CEP</label>
                <input type="text" name="" id="cepAtualizar">
            </div>

            <div class="campo campoRua">
                <label for="rua">RUA</label>
                <input type="text" name="" id="ruaAtualizar">
            </div>

            <div class="campo campoN">
                <label for="numero">Nº</label>
                <input type="number" name="" id="numeroAtualizar">
            </div>

            <div class="campo">
                <label for="complemento">COMPLEMENTO</label>
                <input type="text" name="" id="complementoAtualizar">
            </div>
        </div>
            <button class="botaoAdicionarModal" id="botaoEditar">EDITAR</button>
        </div>
        
    </div> 

    <div class="modal" id="modalVisualizar">
        <div class="modalConteudo">
            <p class="tituloModalAdicionar">ENDEREÇO</p>
            <div class="camposModalAdicionar">

            <div class="campo campoNome">
                <label for="nome">NOME</label>
                <input tabindex="-1" type="text" name="" id="nomeVisualizar">
            </div>

            <div class="campo campoCidade">
                <label for="cidade">CIDADE</label>
                <input tabindex="-1" type="text" name="" id="cidadeVisualizar">
            </div>

            <div class="campo campoCEP">
                <label for="cep">CEP</label>
                <input tabindex="-1" type="text" name="" id="cepVisualizar">
            </div>

            <div class="campo campoRua">
                <label for="rua">RUA</label>
                <input tabindex="-1" type="text" name="" id="ruaVisualizar">
            </div>

            <div class="campo campoN">
                <label for="numero">Nº</label>
                <input tabindex="-1" type="number" name="" id="numeroVisualizar">
            </div>

            <div class="campo complementoVisualizar">
                <label for="complemento">COMPLEMENTO</label>
                <input tabindex="-1" type="text" name="" id="complementoVisualizar">
            </div>
        </div>
        </div>
    </div> 

    <div class="modal" id="modalExcluir">
        <div class="modalExcluir modalConteudo">
            <p class="mensagemConfirmacao">TEM CERTEZA QUE DESEJA EXCLUIR O ENDEREÇO?</p>
            <p class="observacao">OBS: Se ele estiver associado a uma venda, não poderá ser excluído</p>
            <div class="botoesOpcao">
                <button class="desistir">NÃO</button>
                <button class="persistir">SIM, DESEJO!</button>
            </div>
        </div>
    </div> 


    <header>
        <img src="img/logo.png" alt="">
        <div class="opcoesHeader">
            <a href="/paginaPrincipalCliente" class="camposHeader">
                <p class="tituloCamposHeader" >VOLTAR PARA O MENU</p>
                <img src="img/Logout.png" alt="">
            </a>
            <a href="/verCarrinho" class="camposHeader">
                <p class="tituloCamposHeader" >MEU CARRINHO</p>
                <img src="img/carrinho.png" alt="">
            </a>
        </div>
    </header>

    <div class="fotoPerfilUsuario"></div>

    <p class="tituloPerfilUsuario"><%= cliente.nome %></p>

    <div class="dadosUsuario">
        <p class="tituloDadosUsuario">DADOS PESSOAIS</p>
        <div class="primeirosDados">
            <div class="campo">
                <label for="nome">NOME</label>
                <input value="<%= cliente.nome %>" class="campoInputNome" type="text" id="nome">
            </div>
            <div class="campo">
                <label for="cpf">CPF</label>
                <input value="<%= cliente.cpf %>" class="campoInputCPF" type="text" id="cpf">
            </div>
        </div>
        <div class="campo">
            <label for="cpf">DATA DE NASCIMENTO</label>
            <input class="campoInputDN" type="date" id="cpf">
        </div>
    </div>
    <script>
        const enderecos = <%- JSON.stringify(enderecos) %>;
    </script>
    <div class="enderecos">
    <p class="tituloEnderecos">ENDEREÇOS</p>
    <img class="iconeAdicionar" id="botaoAdicionar" src="img/Add.png" alt="">
    <div class="osEnderecos">
        <% for (let i = 0; i < enderecos.length; i++) { %>
        <div class="endereco">
            <div class="nomeEVisualizar">
                <img class="iconeVisualizar" data-index="<%= i %>" src="img/Eye.png" alt="">
                <p class="nomeEndereco"><%= enderecos[i].nome %></p>
            </div>
            <div class="editarEexcluir">
                <img class="iconeEditar" data-id="<%= enderecos[i].idEndereco %>" src="img/Edit.png" alt="">
                <img class="icone" data-id="<%= enderecos[i].idEndereco %>" src="img/Trash.png" alt="">
            </div>
        </div>
        <% } %>
    </div>
</div>

    
    <script src="/js/endereco.js"></script>
    
    
</body>
</html>