<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/produtoVer.css">
    <title>Produto</title>
</head>
<body>
    <header>
        <img class="logo" src="/img/logo.png" alt="">
        <a href="/paginaPrincipalCliente" class="voltarAoMenu">
            <p>VOLTAR AO MENU</p>
            <img src="/img/Logout.png" alt="">
        </a>
    </header>

    <div class="fotoProduto"></div>
    <p class="nomeLoja">ACERBINHO LANCHES</p>
     
    <p class="nomeLanche"><%= produto.nomeProduto %></p>

    <p class="precoProduto">R$ <%= produto.precoProduto %></p>

    <div class="descricaoProduto"><%= produto.descricaoProduto %></div>

    <input type="hidden" name="id" id="idProduto" value="<%= produto.idProduto %>" >

    <button id="botaoAdicionaraoCarrinho" class="botaoAdicionarAoCarrinho">ADICIONAR AO CARRINHO</button>

    <footer></footer>
    
    <script src="/js/produtoVer.js"></script>
</body>
</html>